{
  "name": "hungjurors-trade-analysis",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "unsafe": {
    "bindings": [
      {
        "name": "PER_IP",
        "namespace_id": "49301",
        "simple": {
          "limit": 4,
          "period": 60
        },
        "type": "ratelimit"
      },
      {
        "name": "TOTAL",
        "namespace_id": "49302",
        "simple": {
          "limit": 10,
          "period": 60
        },
        "type": "ratelimit"
      }
    ]
  },
  "vars": {
    "RELEASE": "20260924-current-evidence"
  }
}
