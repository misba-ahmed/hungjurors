{
  "name": "hungjurors-trade-analysis",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "trade-analysis.hungjurors.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "MODEL": "gpt-5.4"
  },
  "ratelimits": [
    {
      "name": "PER_IP",
      "namespace_id": "49301",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "TOTAL",
      "namespace_id": "49302",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
